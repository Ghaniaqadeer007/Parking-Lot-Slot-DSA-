<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Forms\CoverForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\CoverForm.Designer.cs">
      <DependentUpon>CoverForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\MainAllocatorForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\DsaModal.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\warpTextHeading.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>